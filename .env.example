# ==============================================================================
# GOLF-BOT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI API Configuration
# ------------------------------------------------------------------------------
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# 2. WhatsApp Bot Configuration
# ------------------------------------------------------------------------------
# Trigger keyword or prefix when chatting in group (e.g. @caddy, !caddy, !golf)
BOT_TRIGGER_KEYWORD=@caddy

# Bot display persona / name
BOT_NAME="Caddy"

# Optional: Specific WhatsApp group name to listen to (leave empty to respond in any group the bot is in)
WHATSAPP_TARGET_GROUP=

# ------------------------------------------------------------------------------
# 3. 18Birdies Multi-Player Accounts & WhatsApp Phone Mapping
# ------------------------------------------------------------------------------
# Access download page: https://18birdies.com/download-account-data/
# By adding each player's mobile phone number (e.g. +61412345678 or 0412345678),
# the bot automatically knows who sent "@caddy recap" or "!recap" and recaps their round!
#
# Choose ONE of the following options to specify your friends' credentials:
#
# OPTION A: JSON array string in .env (Recommended for Docker):
# BIRDIES_ACCOUNTS='[
#   {"name": "Thilina Fernando", "phone": "+61412345678", "email": "thilina@example.com", "password": "password123"},
#   {"name": "Kasun Perera", "phone": "+61498765432", "email": "kasun@example.com", "password": "password456"},
#   {"name": "Roshan Silva", "phone": "+61411223344", "email": "roshan@example.com", "password": "password789"}
# ]'
#
# OPTION B: Delimited list: "Name:Phone:Email:Password, Name:Phone:Email:Password"
# BIRDIES_ACCOUNTS="Thilina:+61412345678:thilina@example.com:pass123, Kasun:+61498765432:kasun@example.com:pass456"
#
BIRDIES_ACCOUNTS=

# Fallback: Single primary account credentials
BIRDIES_EMAIL=
BIRDIES_PASSWORD=
BIRDIES_PHONE=

# OPTION C: External file path (default: config/players.json)
PLAYERS_CONFIG_PATH=config/players.json

# ------------------------------------------------------------------------------
# 4. Default Golf Course & Weather Location
# ------------------------------------------------------------------------------
DEFAULT_COURSE_NAME="Beaconhills Golf Club"
DEFAULT_COURSE_ADDRESS="85-87 Stoney Creek Road, Beaconsfield Upper VIC 3808"
DEFAULT_COURSE_LAT=-37.9836
DEFAULT_COURSE_LON=145.4182
TIMEZONE=Australia/Melbourne

# Weather alert thresholds
WEATHER_RAIN_THRESHOLD_PERCENT=40
WEATHER_CHECK_HOURS_BEFORE=24,2

# ------------------------------------------------------------------------------
# 5. Background Task Intervals
# ------------------------------------------------------------------------------
# Frequency to check 18Birdies for new rounds (in minutes)
BIRDIES_SYNC_INTERVAL_MINUTES=15

# Frequency to check weather for upcoming tee times (in minutes)
WEATHER_CHECK_INTERVAL_MINUTES=30

# ------------------------------------------------------------------------------
# 6. Web Monitoring Dashboard
# ------------------------------------------------------------------------------
DASHBOARD_PORT=8080
